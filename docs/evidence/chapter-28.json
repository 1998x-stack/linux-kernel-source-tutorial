      "status": "verified"
    },
    {
      "id": "28-device-minor",
      "claim": "The original ramdisk driver uses major 1 and rejects requests whose minor is not 1.",
      "kind": "source",
      "source_url": "https://kernel.googlesource.com/pub/scm/linux/kernel/git/nico/archive/+/v0.11/kernel/blk_drv/ramdisk.c",
      "locator": "MAJOR_NR 1; MINOR(CURRENT->dev) != 1",
      "status": "verified"
    },
    {
      "id": "28-sector-units",
      "claim": "The driver converts request sector and nr_sectors to byte offset and length by shifting left 9; one 1KiB buffer block maps to two 512B sectors.",
      "kind": "source",
      "source_url": "https://kernel.googlesource.com/pub/scm/linux/kernel/git/nico/archive/+/v0.11/kernel/blk_drv/ramdisk.c",
      "locator": "CURRENT->sector << 9; CURRENT->nr_sectors << 9",
      "status": "verified"
    },
    {
      "id": "28-root-load",
      "claim": "hd.c sys_setup calls rd_load before mount_root; rd_load may load a MINIX image from floppy and sets ROOT_DEV to 0x0101.",
      "kind": "source",
      "source_url": "https://kernel.googlesource.com/pub/scm/linux/kernel/git/nico/archive/+/v0.11/kernel/blk_drv/hd.c",
      "locator": "sys_setup; rd_load; mount_root",
      "status": "verified"
    },
