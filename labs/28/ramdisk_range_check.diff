diff --git a/kernel/blk_drv/ramdisk.c b/kernel/blk_drv/ramdisk.c
--- a/kernel/blk_drv/ramdisk.c
+++ b/kernel/blk_drv/ramdisk.c
@@ -27,25 +27,30 @@
 void do_rd_request(void)
 {
 int len;
 char *addr;
+unsigned long capacity, sector, count;
 
 INIT_REQUEST;
-addr = rd_start + (CURRENT->sector << 9);
-len = CURRENT->nr_sectors << 9;
-if ((MINOR(CURRENT->dev) != 1) || (addr+len > rd_start+rd_length)) {
+capacity = (unsigned long)rd_length >> 9;
+sector = CURRENT->sector;
+count = CURRENT->nr_sectors;
+if ((MINOR(CURRENT->dev) != 1) || !count ||
+    sector > capacity || count > capacity - sector) {
     end_request(0);
     goto repeat;
 }
+addr = rd_start + (sector << 9);
+len = count << 9;
 if (CURRENT-> cmd == WRITE) {
 (void ) memcpy(addr,
 CURRENT->buffer,
 len);
 } else if (CURRENT->cmd == READ) {
 (void) memcpy(CURRENT->buffer,
 addr,
 len);
 } else
 panic("unknown ramdisk-command");
 end_request(1);
 goto repeat;
 }
diff --git a/kernel/blk_drv/blk.h b/kernel/blk_drv/blk.h
--- a/kernel/blk_drv/blk.h
+++ b/kernel/blk_drv/blk.h
@@ -120,5 +120,9 @@
 if (!uptodate) {
 printk(DEVICE_NAME " I/O error\n\r");
-printk("dev %04x, block %d\n\r",CURRENT->dev,
-       CURRENT->bh->b_blocknr);
+if (CURRENT->bh)
+    printk("dev %04x, block %d\n\r", CURRENT->dev,
+           CURRENT->bh->b_blocknr);
+else
+    printk("dev %04x, sector %lu\n\r", CURRENT->dev,
+           CURRENT->sector);
 }
